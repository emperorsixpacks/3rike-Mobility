APP_PORT=8080
ENV=development

# Postgres
DATABASE_URL=postgres://3rike:3rike@localhost:5432/3rike?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT — change this in production
JWT_SECRET=change-me-in-production

# Canton JSON Ledger API
# Leave blank to run in stub mode (no Canton node required)
CANTON_URL=http://localhost:7575
CANTON_TOKEN=

# Keycloak OIDC — auto token management (leave CANTON_TOKEN blank when using these)
OIDC_TOKEN_URL=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet
OIDC_USERNAME=your-email@example.com
OIDC_PASSWORD=your-password
